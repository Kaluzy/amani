{
  "name": "amani-field-guide",
  "version": "3.1.0",
  "description": "Amani: an independent open-source field guide with verified signals and a personal comparison workbench.",
  "type": "module",
  "scripts": {
    "build:pages": "node scripts/build-pages.js",
    "verify:dist": "node scripts/verify-dist.js",
    "qa:public": "node scripts/check-public.js",
    "qa:browser": "node scripts/audit-browser.js",
    "fetch": "node scripts/scrape-trending.js all",
    "rank": "node scripts/rank-momentum.js",
    "stats": "node scripts/compute-stats.js",
    "serve": "node scripts/serve-api.js",
    "scrape": "node scripts/scrape-trending.js",
    "refresh": "npm run scrape -- all",
    "full": "npm run refresh && npm run serve",
    "test": "node --test test/*.test.js",
    "qa": "node scripts/qa-check.js",
    "qa:full": "node scripts/qa-check.js --full"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.4.3",
    "cheerio": "^1.0.0",
    "express": "^4.19.2",
    "puppeteer": "^25.16.0"
  }
}
